<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auto_reply_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/auto_reply_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/auto_reply_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/auto_reply"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/auto_reply_nested_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/auto_reply_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/auto_reply_enabled_holder"
                style="@style/SettingsHolderSwitchStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <org.fossify.commons.views.MyMaterialSwitch
                    android:id="@+id/auto_reply_enabled"
                    style="@style/SettingsSwitchStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_reply_enable" />

            </RelativeLayout>

            <org.fossify.commons.views.MyTextView
                android:id="@+id/auto_reply_description"
                style="@style/SettingsTextValueStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/settings_label_start_margin"
                android:paddingTop="@dimen/medium_margin"
                android:paddingEnd="@dimen/settings_label_start_margin"
                android:paddingBottom="@dimen/activity_margin"
                android:text="@string/auto_reply_description" />

            <include
                android:id="@+id/auto_reply_enabled_divider"
                layout="@layout/divider" />

            <TextView
                android:id="@+id/auto_reply_message_label"
                style="@style/SettingsSectionLabelStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@+id/auto_reply_message"
                android:text="@string/auto_reply_message" />

            <org.fossify.commons.views.MyEditText
                android:id="@+id/auto_reply_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/settings_label_start_margin"
                android:layout_marginEnd="@dimen/settings_label_start_margin"
                android:gravity="top|start"
                android:hint="@string/type_a_message"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="1000"
                android:minHeight="48dp"
                android:minLines="2"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/normal_text_size" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/auto_reply_empty_message_warning"
                style="@style/SettingsTextValueStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/settings_label_start_margin"
                android:paddingTop="@dimen/small_margin"
                android:paddingEnd="@dimen/settings_label_start_margin"
                android:text="@string/auto_reply_empty_message_warning"
                android:visibility="gone"
                tools:visibility="visible" />

            <RelativeLayout
                android:id="@+id/auto_reply_cooldown_holder"
                style="@style/SettingsHolderTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/auto_reply_cooldown_label"
                    style="@style/SettingsTextLabelStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_reply_cooldown" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/auto_reply_cooldown"
                    style="@style/SettingsTextValueStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/auto_reply_cooldown_label"
                    tools:text="1 hour" />

            </RelativeLayout>

            <include
                android:id="@+id/auto_reply_message_divider"
                layout="@layout/divider" />

            <TextView
                android:id="@+id/auto_reply_schedule_label"
                style="@style/SettingsSectionLabelStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auto_reply_schedule" />

            <RelativeLayout
                android:id="@+id/auto_reply_schedule_enabled_holder"
                style="@style/SettingsHolderSwitchStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <org.fossify.commons.views.MyMaterialSwitch
                    android:id="@+id/auto_reply_schedule_enabled"
                    style="@style/SettingsSwitchStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_reply_use_schedule" />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/auto_reply_schedule_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/auto_reply_days_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/auto_reply_no_days_warning"
                    style="@style/SettingsTextValueStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/settings_label_start_margin"
                    android:paddingTop="@dimen/small_margin"
                    android:paddingEnd="@dimen/settings_label_start_margin"
                    android:paddingBottom="@dimen/small_margin"
                    android:text="@string/auto_reply_no_days_warning"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <RelativeLayout
                    android:id="@+id/auto_reply_start_time_holder"
                    style="@style/SettingsHolderTextViewStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/auto_reply_start_time_label"
                        style="@style/SettingsTextLabelStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_reply_start_time" />

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/auto_reply_start_time"
                        style="@style/SettingsTextValueStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/auto_reply_start_time_label"
                        tools:text="9:00 AM" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/auto_reply_end_time_holder"
                    style="@style/SettingsHolderTextViewStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/auto_reply_end_time_label"
                        style="@style/SettingsTextLabelStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_reply_end_time" />

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/auto_reply_end_time"
                        style="@style/SettingsTextValueStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/auto_reply_end_time_label"
                        tools:text="5:00 PM" />

                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
